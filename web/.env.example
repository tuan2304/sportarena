# ==============================================================================
# Biến môi trường kết nối Supabase Cloud
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==============================================================================
# Cổng thanh toán VietQR PayOS
# Đăng ký tại https://payos.vn để lấy 3 keys này
# ==============================================================================
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key

# ==============================================================================
# URL ứng dụng Production (Ví dụ: https://pickleball-booking.vercel.app)
# ==============================================================================
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ==========================================
# Giai đoạn 11-12: PayOS riêng của chủ sân + thuê bao
# ==========================================
# Khóa mã hóa các khóa PayOS của chủ sân trước khi lưu DB (32 byte, base64). BẮT BUỘC trên production.
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Đừng đổi sau khi chủ sân đã lưu khóa (khóa cũ sẽ không giải mã được nữa).
PAYMENT_SETTINGS_ENCRYPTION_KEY=

# Ngày bắt đầu giới hạn gói Free (ISO, vd 2027-01-01T00:00:00+07:00). Để trống = miễn phí hoàn toàn, chưa giới hạn.
BILLING_ENFORCED_FROM=

# Giá gói Pro mỗi tháng (VND). Mặc định 199000 chỉ là giá tạm, hãy tự đặt giá của bạn.
PRO_PLAN_PRICE_VND=

# ==========================================
# Trợ lý AI trả lời phiếu hỗ trợ (không bắt buộc)
# ==========================================
# Có khóa: AI tự trả lời phiếu nhóm Đặt sân / Tài khoản / Khác khi chắc chắn, còn lại chuyển cho quản trị.
# Không có khóa: mọi phiếu đều do quản trị trả lời như cũ. Lấy khóa tại https://console.anthropic.com
ANTHROPIC_API_KEY=
# Đặt false để tắt trợ lý mà không phải xóa khóa
SUPPORT_AI_ENABLED=
# Model dùng để trả lời. Mặc định claude-opus-5-5; đổi sang claude-haiku-5-5 nếu muốn rẻ hơn nhiều
SUPPORT_AI_MODEL=

# ==========================================
# Bản đồ Google (không bắt buộc)
# ==========================================
# Có khóa: dùng Maps Embed API chính thức (miễn phí, không giới hạn lượt nhúng). Không có khóa: vẫn hiện bản đồ
# bằng dạng nhúng không cần khóa. Nên GIỚI HẠN khóa theo tên miền web (HTTP referrers) trong Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
