# ==============================================================================
# Biến môi trường kết nối Supabase Cloud
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==============================================================================
# Cổng thanh toán VietQR PayOS
# Đăng ký tại https://payos.vn để lấy 3 keys này
# ==============================================================================
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key

# ==============================================================================
# URL ứng dụng Production (Ví dụ: https://pickleball-booking.vercel.app)
# ==============================================================================
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ==========================================
# Giai đoạn 11-12: PayOS riêng của chủ sân + thuê bao
# ==========================================
# Khóa mã hóa các khóa PayOS của chủ sân trước khi lưu DB (32 byte, base64). BẮT BUỘC trên production.
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Đừng đổi sau khi chủ sân đã lưu khóa (khóa cũ sẽ không giải mã được nữa).
PAYMENT_SETTINGS_ENCRYPTION_KEY=

# Ngày bắt đầu giới hạn gói Free (ISO, vd 2027-01-01T00:00:00+07:00). Để trống = miễn phí hoàn toàn, chưa giới hạn.
BILLING_ENFORCED_FROM=

# Giá gói Pro mỗi tháng (VND). Mặc định 199000 chỉ là giá tạm, hãy tự đặt giá của bạn.
PRO_PLAN_PRICE_VND=

# ==========================================
# Trợ lý trả lời phiếu hỗ trợ (không bắt buộc)
# ==========================================
# Chạy ngay trong app, không cần khóa hay dịch vụ ngoài, không tốn phí: tự trả lời phiếu nhóm Đặt sân / Tài khoản / Khác
# khi câu hỏi khớp rõ với kho FAQ (web/src/lib/support-faq.ts), còn lại chuyển cho quản trị. Bật mặc định.
# Đặt false để tắt: khi đó mọi phiếu đều do quản trị trả lời.
SUPPORT_AI_ENABLED=

# ==========================================
# Bản đồ Google (không bắt buộc)
# ==========================================
# Có khóa: dùng Maps Embed API chính thức (miễn phí, không giới hạn lượt nhúng). Không có khóa: vẫn hiện bản đồ
# bằng dạng nhúng không cần khóa. Nên GIỚI HẠN khóa theo tên miền web (HTTP referrers) trong Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ==========================================
# Giới hạn tần suất theo IP (không bắt buộc)
# ==========================================
# Số proxy tin cậy đứng trước ứng dụng (mặc định 1, đúng với Vercel hoặc một reverse proxy như nginx).
# Đặt 2 nếu có thêm một lớp nữa (vd CDN rồi nginx). Đặt sai thì giới hạn theo IP bị né hoặc gom nhầm mọi người về một IP.
TRUSTED_PROXY_HOPS=

# ==========================================
# Giám sát lỗi (không bắt buộc, nên bật ở production)
# ==========================================
# Thiếu cả hai biến thì lỗi chỉ được ghi vào log của máy chủ.
# SENTRY_DSN: địa chỉ nhận lỗi của Sentry (hoặc GlitchTip). Mọi lỗi máy chủ chưa bắt được và các sự cố đáng chú ý
#   (ghi nhận thanh toán thất bại, AI hỏng, xóa tài khoản dở dang...) được gửi lên đó. Không gửi email, số điện thoại hay nội dung tin nhắn.
SENTRY_DSN=
# ALERT_WEBHOOK_URL: webhook đến Slack hoặc Discord. Chỉ các sự cố cần người xử lý ngay mới đẩy vào đây (webhook PayOS trả 5xx,
#   lớp giới hạn tần suất tự tắt vì lỗi, trợ lý AI hỏng). Cùng một sự cố lặp lại chỉ báo một lần mỗi 10 phút.
ALERT_WEBHOOK_URL=

# ==========================================
# Liên hệ hỗ trợ (không bắt buộc)
# ==========================================
# Hiện trên trang /delete-account cho người không đăng nhập được. Để trống thì không hiện dòng liên hệ.
NEXT_PUBLIC_SUPPORT_EMAIL=

# ==========================================
# Tác vụ định kỳ: nhắc lịch, danh sách chờ, lịch cố định (bắt buộc để các tính năng này chạy)
# ==========================================
# Chuỗi bí mật bảo vệ endpoint /api/cron/tick (tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Chưa đặt thì endpoint từ chối mọi lời gọi. Đặt cùng giá trị này vào secret CRON_SECRET của GitHub để workflow cron-tick.yml gọi được.
CRON_SECRET=

# ==========================================
# Đăng nhập Google / Apple / OTP điện thoại / Zalo (không bắt buộc)
# ==========================================
# Danh sách cách đăng nhập hiện thành nút ở trang đăng nhập, ví dụ: google,apple,phone
# Chỉ khai báo sau khi đã bật nhà cung cấp tương ứng trong Supabase Dashboard → Authentication → Providers
# (phone cần thêm nhà cung cấp SMS ở Authentication → Providers → Phone).
AUTH_PROVIDERS=
# Zalo: tạo ứng dụng tại https://developers.zalo.me, bật "Đăng nhập với Zalo" và thêm Callback URL
# {NEXT_PUBLIC_APP_URL}/api/auth/zalo/callback. Có đủ hai biến này thì nút Zalo tự hiện.
ZALO_APP_ID=
ZALO_APP_SECRET=
# Miền dùng cho email định danh nội bộ của tài khoản Zalo (zalo-<id>@miền). Mặc định lấy từ NEXT_PUBLIC_APP_URL;
# chỉ đặt nếu Supabase Auth từ chối miền đó.
ZALO_EMAIL_DOMAIN=

# ==========================================
# OTP qua nhà cung cấp SMS Việt Nam (không bắt buộc; thay cho Twilio/Vonage... của Supabase)
# ==========================================
# Bật "Send SMS hook" trong Supabase Dashboard → Authentication → Hooks → Send SMS → HTTPS,
# URL: {NEXT_PUBLIC_APP_URL}/api/auth/sms-hook, rồi sao chép secret (dạng v1,whsec_...) vào SEND_SMS_HOOK_SECRET.
SEND_SMS_HOOK_SECRET=
# speedsms hoặc esms
SMS_PROVIDER=
# SpeedSMS: token tại https://speedsms.vn (SPEEDSMS_SENDER = brandname đã đăng ký, bỏ trống để gửi tin chăm sóc khách hàng)
SPEEDSMS_TOKEN=
SPEEDSMS_SENDER=
# eSMS: khóa tại https://esms.vn (ESMS_BRANDNAME = brandname đã đăng ký, bỏ trống để gửi tin số ngẫu nhiên)
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=
# Tên hiện trong nội dung tin nhắn (mặc định SportArena)
SMS_BRAND=
