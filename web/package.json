{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:types": "supabase gen types typescript --linked --workdir .. > src/types/supabase.generated.ts",
    "db:test": "bash ../supabase/tests/run.sh",
    "sync:mobile": "node scripts/sync-mobile-shared.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "payos:webhook": "node --env-file=.env.local scripts/register-payos-webhook.mjs",
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "e2e": "playwright test",
    "e2e:real": "node e2e-real/run.mjs",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@payos/node": "^2.0.5",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.47.0",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "three": "^0.180.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.180.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
