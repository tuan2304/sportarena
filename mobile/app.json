{
  "expo": {
    "name": "SportArena",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.sportarena.app"
    },
    "android": {
      "package": "vn.sportarena.app",
      "adaptiveIcon": {
        "backgroundColor": "#064E3B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#059669"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SportArena cần truy cập thư viện ảnh để bạn chọn ảnh đại diện.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SportArena cần vị trí của bạn để ghim sân lên bản đồ."
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "459737f3-4b12-434f-8e11-6efe188e37db"
      }
    },
    "owner": "vutuan2304",
    "updates": {
      "url": "https://u.expo.dev/459737f3-4b12-434f-8e11-6efe188e37db"
    }
  }
}
