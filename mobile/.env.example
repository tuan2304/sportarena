# Sao chép thành .env rồi điền giá trị (Supabase Dashboard > Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key>
# Địa chỉ máy chủ web (không có dấu / cuối). Dùng để giữ chỗ, hủy đơn và báo đã chuyển khoản
EXPO_PUBLIC_API_URL=https://<ten-mien-cua-ban>.vercel.app

# Cách đăng nhập hiện thành nút ở màn hình đăng nhập (google, apple, phone, zalo; cách nhau bằng dấu phẩy).
# Chỉ khai báo sau khi đã bật nhà cung cấp tương ứng ở Supabase / web (xem DEPLOYMENT.md). Google/Apple cần thêm
# sportarena://auth-callback vào Redirect URLs của Supabase; Zalo cần ZALO_APP_ID/ZALO_APP_SECRET trên web.
EXPO_PUBLIC_AUTH_PROVIDERS=
